# Шаблон секретов. Скопируй в .env и впиши значения.
# .env под .gitignore — в репозиторий не попадёт.

# --- Yandex Cloud Search API (Wordstat) — Шаги 1 и 3 ---
# API-ключ: Yandex Cloud Console → AI Studio → API-ключи (привязан к сервисному аккаунту).
WORDSTAT_API_KEY=
# folder_id каталога Yandex Cloud (вида b1gxxxxxxxxxxxxxxxxx).
WORDSTAT_FOLDER_ID=

# --- (опц.) Прямой режим scripts/forecast_cpc.py вне MCP-сессии ---
# Обычно прогноз CPC идёт через MCP yandex-direct, токен здесь НЕ нужен.
# YANDEX_DIRECT_TOKEN=

# --- Генерация визуалов (Шаг 8.5) ---
# Приоритет: env → ~/.yandex-direct-manager/credentials.json (manage_credentials).
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
